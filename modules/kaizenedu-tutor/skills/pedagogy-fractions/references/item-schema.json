{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check item",
  "type": "object",
  "required": ["id", "skill", "type", "stem", "representation", "band", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "skill": { "type": "string", "pattern": "^F(1[0-2]|[1-9])$" },
    "type": { "enum": ["single", "multiple", "numeric", "short", "symbolic"] },
    "context": {
      "type": "string",
      "description": "The surface the item wears (word-problem, bare-computation, compare, generate, simplify …); the two-contexts rule needs it."
    },
    "stem": { "type": "string", "minLength": 8 },
    "representation": { "enum": ["bar", "number_line", "set", "symbolic", "word"] },
    "band": { "enum": ["9-12", "13-17", "both"] },
    "source": { "type": "string" },
    "options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "correct"],
        "properties": {
          "text": { "type": "string" },
          "correct": { "type": "boolean" },
          "misconception": { "type": "string" }
        }
      }
    },
    "answer": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": ["number", "string"],
          "description": "A number or a fraction string for numeric; text for short; an expression in x for symbolic."
        },
        "tolerance": { "type": "number", "minimum": 0 },
        "units": { "type": "string" },
        "accept": { "type": "array", "items": { "type": "string" } },
        "wrong": {
          "type": "array",
          "description": "Answers a known mistake produces, each with the misconception it reveals.",
          "items": {
            "type": "object",
            "required": ["value", "misconception"],
            "properties": {
              "value": { "type": ["number", "string"] },
              "misconception": { "type": "string" }
            }
          }
        },
        "keywords": {
          "type": "array",
          "description": "Short answers only: the content words a free-text answer must contain.",
          "items": { "type": "string" }
        },
        "exact": {
          "type": "boolean",
          "description": "Short answers only: refuse a numerically equal answer written in another form."
        }
      }
    },
    "rationale": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
  }
}
