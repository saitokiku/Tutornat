# ── Kaizen AI — web app environment ───────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, set these in Project Settings.
# All intelligence (tutoring, grading, syllabus intake) runs on Claude.
# Voice — and ONLY voice — uses the OpenAI audio APIs.
#
# Production runs in full SaaS mode: ANTHROPIC + OPENAI + all three Supabase
# keys are required. Stripe/email/observability are optional add-ons.

# REQUIRED — the tutor brain (everything except voice)
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (defaults shown; override without code changes)
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_TUTOR=claude-sonnet-5
CLAUDE_MODEL_DEEP=claude-opus-4-8

# REQUIRED for SaaS — Supabase (auth + Postgres + RLS). All three needed together.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server only — never NEXT_PUBLIC

# Admin bootstrap: emails auto-promoted to admin role + internal plan
ADMIN_EMAILS=you@kaizentutors.com

# REQUIRED for voice — OpenAI audio APIs only (STT: Whisper, TTS, Realtime).
# This is the ONLY place OpenAI is used; all text intelligence stays on Claude.
# Without this key, the mic/voice button is disabled (text tutoring still works).
OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=gpt-4o-mini-transcribe   # speech-to-text (Whisper family)
OPENAI_TTS_MODEL=gpt-4o-mini-tts          # text-to-speech
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview  # low-latency realtime path

# SCHEDULED MAINTENANCE — required in production. Vercel Cron calls
# /api/cron/maintenance hourly (see vercel.json) with this bearer secret:
# releases abandoned payment holds, sends T-24h reminders, and enforces the
# 24-month transcript retention schedule (docs/compliance/RETENTION.md).
CRON_SECRET=

# RATE LIMITING — strongly recommended in production. With Upstash Redis set,
# burst limits hold across all serverless instances; without it they fall back
# to per-instance memory (weaker under scale-out).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LIVE TUTOR VIDEO — Daily.co (optional; the "Book a tutor" flow degrades to a
# clear "not configured" message without it). Server-only key: rooms + tokens
# are minted server-side, never exposed to the browser.
# Safeguarding note: sessions involve minors — require guardian consent (the
# booking UI enforces a consent checkbox) and set a monitoring/recording policy
# before enabling for real students.
DAILY_API_KEY=
DAILY_DOMAIN=your-team.daily.co

# EMAIL — Resend. Optional to boot, but effectively REQUIRED in production: it
# powers every transactional email — tutor hiring decisions, booking + refund
# confirmations, T-24h reminders, and post-session recaps. Without it those all
# no-op (logged to console), so the flows "work" but no one gets notified.
RESEND_API_KEY=re_...
EMAIL_FROM=Kaizen AI <reports@kaizentutors.com>

# BILLING — Stripe (optional; /billing shows "not live yet" without it).
# Covers BOTH subscriptions (the AI plans) and pay-per-session tutoring: booking
# a live session creates a one-off Checkout charge at the tutor's rate. Without
# Stripe, bookings fall back to plan-metered (no charge), so the app still works.
# 1. Create recurring Prices in Stripe. EVERY figure below is copied from
#    web/lib/server/clubPricing.js — check it there before you click Create;
#    Stripe Prices are immutable and a wrong one is replaced, not edited.
#      Standing Seat $550/mo → STRIPE_PRICE_SEAT   (the one Local product,
#                                                  docs/STRATEGY.md §5.1)
#      Max AI        $11.99/mo → STRIPE_PRICE_AI_SOLO (the one AI upgrade)
#      AI + Hall     $24.99/mo → STRIPE_PRICE_AI_HALL (built; leave UNSET at launch)
#    And ONE one-time Price (not recurring):
#      Placement diagnostic $59 one-time → STRIPE_PRICE_DIAGNOSTIC
#                                                  (clubPricing.DIAGNOSTIC; the
#                                                  first thing the Program
#                                                  Director sells)
#    Club $45 / Plus $79 / Max $109 are RETIRED FROM SALE (clubPricing.SALE_STATUS,
#    2026-09-02). Their live Prices exist; leave the envs set only so any event
#    on those ids keeps resolving. Nothing sells them.
#    No card trial — the free weekly Community Hall is the trial.
#    STRIPE_PRICE_STUDENT / STRIPE_PRICE_FAMILY are legacy tiers; leave them
#    unset unless you have old subscribers whose price IDs must keep resolving.
# 2. Add a webhook endpoint: <APP_URL>/api/billing/webhook with events
#    checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted — then paste its signing secret below. The
#    same checkout.session.completed event fulfills per-session payments (routed
#    by metadata.tutoring_session_id).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SEAT=price_...
STRIPE_PRICE_CLUB=price_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_MAX=price_...
STRIPE_PRICE_AI_SOLO=price_...
STRIPE_PRICE_AI_HALL=price_...
# One-time (mode:'payment'), not a subscription:
STRIPE_PRICE_DIAGNOSTIC=price_...
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_FAMILY=

# Public base URL for Stripe redirects + password-reset emails
APP_URL=http://localhost:3000

# IMAGE GENERATION — Google Gemini/Imagen (optional, lowest priority). When set,
# the chat can render an ```image fence into a generated picture (click-to-
# generate). Without it, the chat shows a friendly "not enabled" chip.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# OBSERVABILITY (optional; both no-op silently when unset)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

APP_ENV=development
