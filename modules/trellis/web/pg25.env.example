# Branch-local PostgreSQL for E4 round 1 (never the shared kaizenedu_e2).
# Copy to a file OUTSIDE the tree and export KAIZENEDU_PG_ENV=<that file>.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=kaizen_owner
PGDATABASE=kaizenedu_25
KAIZENEDU_PG_URL=postgresql://kaizen_owner@127.0.0.1:5433/kaizenedu_25
KAIZENEDU_PG_TUTOR_URL=postgresql://kz_home_tutor@127.0.0.1:5433/kaizenedu_25
KAIZENEDU_PG_REPORT_URL=postgresql://kz_home_report@127.0.0.1:5433/kaizenedu_25
PGBIN=/usr/local/opt/postgresql@17/bin
LC_ALL=en_US.UTF-8
