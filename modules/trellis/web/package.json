{
  "name": "kaizenedu-web",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "KaizenEdu web surface (E4): Trellis tutors one synthetic fractions lesson against the E2 seam; the honest record beside the chat.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "E2_PG_MODULES=./node_modules node ../db/migrate.cjs",
    "seed": "E2_PG_MODULES=./node_modules node scripts/seed.cjs",
    "smoke": "E2_PG_MODULES=./node_modules node scripts/smoke.cjs",
    "test:pg-resolution": "node --test scripts/resolve-pg.test.cjs",
    "vercel-build": "if [ -n \"$KAIZENEDU_PG_URL\" ]; then npm run migrate && npm run seed; else echo 'No database configured: building demo mode'; fi && next build"
  },
  "dependencies": {
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
