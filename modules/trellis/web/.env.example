# Copy to web/.env.local (git-ignored). Never commit real values.
# Owner connection: migrations + seed run with this at build time (Neon: the default role).
KAIZENEDU_PG_URL=postgresql://kaizen_owner@127.0.0.1:5433/kaizenedu_25
# Runtime connections. The seam derives the household from session_user (e2.principals),
# so the app connects as the seeded LOGIN roles, never as the owner.
KAIZENEDU_PG_TUTOR_URL=postgresql://kz_home_tutor@127.0.0.1:5433/kaizenedu_25
KAIZENEDU_PG_REPORT_URL=postgresql://kz_home_report@127.0.0.1:5433/kaizenedu_25
# Neon requires passwords; the seed sets this password on both app roles when present.
# KAIZENEDU_APP_PASSWORD=
# Optional. Absent: Trellis uses the scripted fallback (still fully testable).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
