# KaizenEDU web app. Copy to .env.local (never commit it). Everything works without these: the tutor
# runs as the demo tutor and lessons start from templates.

# AI, pick one. Anthropic directly is preferred.
ANTHROPIC_API_KEY=
# On Vercel, an Anthropic key is only used when this is also set (keeps old keys in the project inert):
# KAIZEN_AI=anthropic
# Or Vercel AI Gateway (Anthropic models only):
# AI_GATEWAY_API_KEY=
# Or, on Vercel, the deployment's own OIDC token through AI Gateway:
# KAIZEN_AI=gateway

# Optional model overrides
# KAIZEN_MODEL_TALK=claude-sonnet-5-5
# KAIZEN_MODEL_BUILD=claude-opus-5-5
# KAIZEN_MODEL_QUICK=claude-haiku-4-5
